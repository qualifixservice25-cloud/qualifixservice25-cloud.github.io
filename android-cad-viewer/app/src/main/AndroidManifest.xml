<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Nessun permesso di accesso all'archivio: i file arrivano dallo Storage Access Framework,
        quindi l'app vede solo il documento che l'utente sceglie di aprire.
    -->

    <!--
        Serve solo per parlare con il server di conversione DWG che l'utente configura da solo
        (vedi server/README.md): l'app non ha un server proprio e non contatta nient'altro.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CadViewer">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Apertura di un DXF o DWG da file manager, allegato email o app cloud. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/dxf" />
                <data android:mimeType="image/vnd.dxf" />
                <data android:mimeType="application/acad" />
                <data android:mimeType="image/vnd.dwg" />
            </intent-filter>

            <!--
                Molti gestori file dichiarano i DXF/DWG come flusso di byte generico: si accetta
                anche quel caso, ma solo per i file la cui estensione e' davvero una delle due.
                Un .dwg aperto cosi' richiede comunque il server di conversione configurato
                (vedi DrawingRepository.looksLikeDwg e ConversionSettings).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.dxf" />
                <data android:pathPattern=".*\\.DXF" />
                <data android:pathPattern=".*\\.dwg" />
                <data android:pathPattern=".*\\.DWG" />
            </intent-filter>
        </activity>
    </application>
</manifest>
