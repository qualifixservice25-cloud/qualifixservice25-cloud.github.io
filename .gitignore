# La build web di Sviluppo Lamiera non sta più nel repository: la genera la
# GitHub Action a ogni push su main e la spedisce a Netlify. La riga resta
# perché chi compila in locale se la ritrova qui e non deve committarla.
/sviluppo-lamiera/

# Flutter / Dart (sviluppo-lamiera-app/)
sviluppo-lamiera-app/**/.dart_tool/
sviluppo-lamiera-app/**/build/
sviluppo-lamiera-app/**/.flutter-plugins
sviluppo-lamiera-app/**/.flutter-plugins-dependencies
sviluppo-lamiera-app/**/.idea/
sviluppo-lamiera-app/app/android/.gradle/
sviluppo-lamiera-app/app/android/local.properties

# I pubspec.lock restano tracciati: sono applicazioni, non librerie, e la build
# riproducibile vale più della pulizia del diff. Anche .vscode/ resta tracciata:
# i task in italiano servono a chi apre il progetto, non sono roba personale.

*.iml
.DS_Store
